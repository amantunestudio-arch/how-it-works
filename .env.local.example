# PUBLISH_MODE: github (git push, GitHub Pages) ya tiiny (zip build + Tiiny upload).
# Khali chhodo to: .git folder ho to github, nahi to tiiny.
PUBLISH_MODE=
# Is file ko copy karke `.env.local` naam do aur values bharo. Ye file kisi ko mat do.
# Tiiny.host > Manage Account se API key milti hai (API Solo plan ya usse upar me chalti hai).
TIINY_API_KEY=
# Tiiny par jo site pehle se bani hai uska domain, jaise  mysite.tiiny.site
TIINY_DOMAIN=
